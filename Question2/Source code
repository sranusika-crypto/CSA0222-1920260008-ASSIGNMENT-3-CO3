#include <stdio.h>
#include <string.h>

void copy_arr(int dest[], const int src[], int n) {
    for (int i = 0; i < n; i++) dest[i] = src[i];
}

void bubble_sort(int a[], int n, long *comps, long *swaps) {
    *comps = *swaps = 0;
    for (int i = 0; i < n - 1; i++) {
        int swapped = 0;
        for (int j = 0; j < n - 1 - i; j++) {
            (*comps)++;
            if (a[j] > a[j + 1]) {
                int tmp = a[j]; a[j] = a[j + 1]; a[j + 1] = tmp;
                (*swaps)++;
                swapped = 1;
            }
        }
        if (!swapped) break; // Early exit
    }
}

void selection_sort(int a[], int n, long *comps, long *swaps) {
    *comps = *swaps = 0;
    for (int i = 0; i < n - 1; i++) {
        int min_idx = i;
        for (int j = i + 1; j < n; j++) {
            (*comps)++;
            if (a[j] < a[min_idx]) min_idx = j;
        }
        if (min_idx != i) {
            int tmp = a[i]; a[i] = a[min_idx]; a[min_idx] = tmp;
            (*swaps)++;
        }
    }
}

void insertion_sort(int a[], int n, long *comps, long *shifts) {
    *comps = *shifts = 0;
    for (int i = 1; i < n; i++) {
        int key = a[i];
        int j = i - 1;
        while (j >= 0) {
            (*comps)++;
            if (a[j] > key) {
                a[j + 1] = a[j];
                (*shifts)++;
                j--;
            } else {
                break;
            }
        }
        a[j + 1] = key;
    }
}

int main(void) {
    int n = 6;
    int sorted[]  = {101, 102, 103, 104, 105, 106};
    int nearly[]  = {101, 102, 105, 103, 104, 106};
    int reverse[] = {106, 105, 104, 103, 102, 101};
    int random[]  = {104, 101, 106, 102, 105, 103};

    const char *names[] = {"Sorted", "Nearly Sorted", "Reverse", "Random"};
    int *datasets[] = {sorted, nearly, reverse, random};
    int temp[6];
    long c, s;

    for (int d = 0; d < 4; d++) {
        printf("--- %s ---\n", names[d]);
        copy_arr(temp, datasets[d], n);
        bubble_sort(temp, n, &c, &s);
        printf("Bubble    -> Comps: %ld, Swaps: %ld\n", c, s);

        copy_arr(temp, datasets[d], n);
        selection_sort(temp, n, &c, &s);
        printf("Selection -> Comps: %ld, Swaps: %ld\n", c, s);

        copy_arr(temp, datasets[d], n);
        insertion_sort(temp, n, &c, &s);
        printf("Insertion -> Comps: %ld, Shifts: %ld\n", c, s);
    }
    return 0;
}
