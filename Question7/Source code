#include <stdio.h>

#define MAX_CANDIDATES 12

typedef struct {
    int id;
    int votes;
} CandidateResult;

int main(void) {
    int num_candidates = 4;
    // Sample poll stream containing valid votes (1..4) and invalid votes (0, -2, 7)
    int ballots[] = {2, 1, 3, 2, 0, 4, 1, 2, -2, 1, 3, 7, 4};
    int total_entries = sizeof(ballots) / sizeof(ballots[0]);

    int counts[MAX_CANDIDATES + 1] = {0}; // 1-indexed count array
    int valid_votes = 0, invalid_votes = 0;

    // 1. One-pass O(v) counting
    for (int i = 0; i < total_entries; i++) {
        int vote = ballots[i];
        if (vote >= 1 && vote <= num_candidates) {
            counts[vote]++;
            valid_votes++;
        } else {
            invalid_votes++;
        }
    }

    // 2. Populate results array and sort descending by votes
    CandidateResult results[MAX_CANDIDATES];
    for (int c = 1; c <= num_candidates; c++) {
        results[c - 1].id = c;
        results[c - 1].votes = counts[c];
    }

    for (int i = 0; i < num_candidates - 1; i++) {
        for (int j = 0; j < num_candidates - 1 - i; j++) {
            if (results[j].votes < results[j + 1].votes) {
                CandidateResult tmp = results[j];
                results[j] = results[j + 1];
                results[j + 1] = tmp;
            }
        }
    }

    // 3. Report tallies and detect winner / tie
    printf("Total Entries: %d | Valid: %d | Invalid: %d\n\n",
           total_entries, valid_votes, invalid_votes);
    printf("Standings (Descending):\n");
    for (int i = 0; i < num_candidates; i++) {
        printf("  Candidate %d: %d votes\n", results[i].id, results[i].votes);
    }

    if (valid_votes == 0) {
        printf("\nResult: No valid votes cast.\n");
    } else if (num_candidates > 1 && results[0].votes == results[1].votes) {
        printf("\nResult: TIE between ");
        for (int i = 0; i < num_candidates && results[i].votes == results[0].votes; i++) {
            printf("Candidate %d ", results[i].id);
        }
        printf("with %d votes each.\n", results[0].votes);
    } else {
        printf("\nResult: Candidate %d WINS with %d votes.\n",
               results[0].id, results[0].votes);
    }

    return 0;
}
